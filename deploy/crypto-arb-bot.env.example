# -----------------------------------------------------------------------------
# Crypto Arbitrage Bot — environment file
# Copy to /etc/crypto-arb-bot.env, fill in the values, then: chmod 600 it.
# Loaded by the systemd service (EnvironmentFile=). Simple KEY=value lines only.
# -----------------------------------------------------------------------------

# Port the server listens on (required — the process exits if unset).
PORT=5000

# Bind address. Keep 127.0.0.1 so the dashboard — which has no login and can
# place real orders — is NEVER reachable on a public interface. Access it over
# an SSH tunnel. Only change to 0.0.0.0 if you put an authenticating reverse
# proxy (with HTTPS) in front of it.
HOST=127.0.0.1

NODE_ENV=production
LOG_LEVEL=info

# Absolute path to the built dashboard, served on the same origin as the API.
PUBLIC_DIR=/opt/crypto-arb-bot/artifacts/arb-dashboard/dist/public

# Encrypts the persisted Binance credentials at rest (AES-256-GCM).
# Generate a value with:   openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32

# Optional: supply Binance keys via env instead of typing them into the
# dashboard. If set, these take priority and are never written to disk —
# the most secure option. Leave commented to use the dashboard form instead.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
